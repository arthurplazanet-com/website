---
import { Font } from 'astro:assets'

// The site's only stylesheet: @use-compose/ui's CSS, the design tokens and the
// document defaults, in that cascade order. Nothing imported it before, so the
// library's components rendered their markup with none of the classes it ships
// (`.card`, `.cluster`) and every `--space-*` in the layout primitives resolved
// to nothing — which is what made the card list look unstyled.
import '../assets/css/main.css'

export interface Props {
  title?: string
}

const { title = 'Arthur Plazanet - Software Engineer' } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-aporetic-sans-mono" />

    <title>{title}</title>
  </head>
  <body class="app">
    <!--
        Three radios are the whole state. The turn, the spine highlight and the
        filters all read them through :has(), so the shelf works before this
        island hydrates and keeps working with the <script> below deleted.
      - <input id="book-id" class="shelf-state" type="radio" name="book" checked />
    <input id="book-projects" class="shelf-state" type="radio" name="book" />
    <input id="book-experience" class="shelf-state" type="radio" name="book" /> -->
    <slot />
  </body>
</html>

<style>
  body {
    font-family: var(--font-aporetic-sans-mono);
  }
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-aporetic-serif-mono);
  }
</style>
