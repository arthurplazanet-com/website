---
import Layout from '../layouts/Layout.astro'
import HomeView from '../components/vue/views/HomeView.vue'
import type { Project } from '../types/index.ts'

// A dead API shouldn't take the build down with it — the list renders its own
// empty state, so fall back to nothing and keep going.
let projects: Project[] = []
try {
  const response = await fetch(`${import.meta.env.PUBLIC_API_URL}/content/projects`)
  const data = response.ok ? await response.json() : []
  projects = Array.isArray(data) ? data : []
} catch (error) {
  console.warn('[index] could not load projects:', error)
}
---

<Layout title="Arthur Plazanet - Software Engineer">
  <HomeView client:load projects={projects} />
</Layout>
