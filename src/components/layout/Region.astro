---
// Thin wrapper around the `.region` CUBE layout primitive
// (src/assets/css/cube/layout.css) so pages don't repeat the class name.
interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<section class:list={["region", className]} {...rest}>
  <slot />
</section>
