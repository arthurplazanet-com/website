---
// Thin wrapper around the `.reel` CUBE layout primitive
// (src/assets/css/cube/layout.css) so pages don't repeat the class name. The
// styles live there; this component contributes the behaviour below — snap
// stepping, drag-to-scroll and the optional position readout.
interface Props {
  class?: string;
  /**
   * Show a "03 / 14" position readout under the reel. Off by default so the
   * primitive stays as thin as it was for any other use.
   */
  counter?: boolean;
  [key: string]: unknown;
}

const { class: className, counter = false, ...rest } = Astro.props;
---

<div class="reel-shell">
  <div class:list={["reel", className]} {...rest}>
    <slot />
  </div>

  {
    /*
     * Outside the scrolling element, or it would scroll away with the images.
     * `aria-hidden` because the reel already announces itself as a labelled
     * region — a live readout firing on every image would just be noise, and
     * screen-reader users get the count from the image list itself.
     */
  }
  {
    counter && (
      <p class="reel-counter" aria-hidden="true">
        <span data-reel-index>1</span>
        <span class="reel-counter__sep">/</span>
        <span data-reel-total />
      </p>
    )
  }
</div>

<script>
  // https://every-layout.dev/layouts/reel/ — toggle `.overflowing` only when
  // the reel is actually scrollable, so the scrollbar gutter doesn't appear
  // as dead space otherwise.
  const reels = Array.from(document.querySelectorAll<HTMLElement>(".reel"));

  const toggleOverflowClass = (elem: HTMLElement) => {
    elem.classList.toggle("overflowing", elem.scrollWidth > elem.clientWidth);
  };

  for (const reel of reels) {
    // Anything that has to re-run when the reel's layout changes — cached
    // child offsets, the position readout. Registered further down as each
    // piece is set up, and run in registration order.
    const layoutListeners: Array<() => void> = [];
    const onLayoutChange = (elem: HTMLElement) => {
      toggleOverflowClass(elem);
      for (const listener of layoutListeners) listener();
    };

    new ResizeObserver((entries) => {
      onLayoutChange(entries[0].target as HTMLElement);
    }).observe(reel);

    new MutationObserver((entries) => {
      onLayoutChange(entries[0].target as HTMLElement);
    }).observe(reel, { childList: true });

    /*
     * Offsets are cached: `base` already subtracts `scrollLeft`, so these are
     * content coordinates that only change when layout does, and recomputing
     * 14 rects on every scroll frame would be a needless thrash.
     */
    let cachedPoints: number[] | null = null;
    const invalidatePoints = () => {
      cachedPoints = null;
    };

    const snapPoints = () => {
      if (cachedPoints) return cachedPoints;
      const base = reel.getBoundingClientRect().left - reel.scrollLeft;
      cachedPoints = Array.from(reel.children).map((child) =>
        Math.round(child.getBoundingClientRect().left - base),
      );
      return cachedPoints;
    };

    // First, so the readout below always recomputes against fresh offsets.
    layoutListeners.push(invalidatePoints);

    const nearestPoint = () => {
      const points = snapPoints();
      let index = 0;
      let best = Infinity;
      points.forEach((point, i) => {
        const distance = Math.abs(point - reel.scrollLeft);
        if (distance < best) {
          best = distance;
          index = i;
        }
      });
      return { index, left: points[index] ?? 0, total: points.length };
    };

    /*
     * Move a whole image at a time rather than by raw pixel delta. The reel
     * snaps (`scroll-snap-type` in the styles below), and snapping actively
     * fights small imperative `scrollLeft` writes — a 120px wheel tick gets
     * pulled straight back to the snap point it came from, so pixel-stepping
     * leaves the reel apparently frozen. Stepping between snap points is what
     * the snap behaviour is for, and it gives a cleaner gallery feel anyway.
     */
    let stepping = false;
    const step = (direction: number) => {
      const points = snapPoints();
      const current = reel.scrollLeft;
      const target =
        direction > 0
          ? points.find((p) => p > current + 1)
          : [...points].reverse().find((p) => p < current - 1);

      if (target === undefined) return false;

      stepping = true;
      reel.scrollTo({ left: target, behavior: "smooth" });
      // A trackpad flick fires many wheel events; without this one gesture
      // would rip through half the reel.
      window.setTimeout(() => {
        stepping = false;
      }, 320);
      return true;
    };

    // How many images vertical scrolling may advance before the page takes its
    // input back. Holding the page hostage until the reel was exhausted meant
    // 14 images = ~10 screenfuls of sideways scrolling before the page would
    // move on, which reads as a broken page rather than as a gallery. Three is
    // enough to make the reel's existence obvious; everything past that is
    // reachable by deliberate horizontal gesture, drag, or the arrow keys.
    const STEP_BUDGET = 3;
    let budget = STEP_BUDGET;

    // Re-arm once the reel has been scrolled away from, so returning to the
    // gallery later behaves the same as arriving at it the first time.
    new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) budget = STEP_BUDGET;
        }
      },
      { threshold: 0 },
    ).observe(reel);

    /*
     * Vertical wheel/trackpad input over the reel drives it horizontally
     * instead of falling through to the page's (ScrollSmoother-driven)
     * vertical scroll — otherwise a small wheel nudge snaps straight past the
     * gallery before its images can be browsed. That capture is budgeted
     * rather than absolute, per `STEP_BUDGET` above.
     */
    reel.addEventListener(
      "wheel",
      (event) => {
        const horizontal = Math.abs(event.deltaX) > Math.abs(event.deltaY);
        const delta = horizontal ? event.deltaX : event.deltaY;
        if (delta === 0) return;

        const atStart = reel.scrollLeft <= 0;
        const atEnd =
          reel.scrollLeft + reel.clientWidth >= reel.scrollWidth - 1;

        if ((delta > 0 && atEnd) || (delta < 0 && atStart)) return;

        // A sideways gesture is the user explicitly driving the reel, so it
        // always works and never counts against the budget — only vertical
        // input is being borrowed from the page.
        if (!horizontal && budget <= 0) return;

        event.preventDefault();

        if (stepping) return;
        if (step(Math.sign(delta)) && !horizontal) budget -= 1;
      },
      { passive: false },
    );

    /*
     * Click-and-drag. Touch already scrolls the reel natively, so this is for
     * mouse and pen only — claiming touch pointers here would just fight the
     * platform's own momentum scrolling.
     */
    let dragging = false;
    let dragMoved = false;
    let dragOriginX = 0;
    let dragOriginScroll = 0;

    reel.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "touch" || event.button !== 0) return;
      if ((event.target as HTMLElement).closest("a, button, input, label"))
        return;

      dragging = true;
      dragMoved = false;
      dragOriginX = event.clientX;
      dragOriginScroll = reel.scrollLeft;
      // Snap fights imperative `scrollLeft` writes the same way it does in the
      // wheel handler above, so it comes off for the duration of the drag and
      // the release settles onto a point explicitly.
      reel.style.scrollSnapType = "none";
      reel.classList.add("is-dragging");
      reel.setPointerCapture(event.pointerId);
    });

    reel.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      const moved = event.clientX - dragOriginX;
      if (Math.abs(moved) > 3) dragMoved = true;
      reel.scrollLeft = dragOriginScroll - moved;
    });

    const endDrag = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      reel.classList.remove("is-dragging");
      reel.style.scrollSnapType = "";
      if (reel.hasPointerCapture(event.pointerId))
        reel.releasePointerCapture(event.pointerId);
      // Settle deliberately rather than hoping `proximity` decides to catch it.
      if (dragMoved)
        reel.scrollTo({ left: nearestPoint().left, behavior: "smooth" });
    };

    reel.addEventListener("pointerup", endDrag);
    reel.addEventListener("pointercancel", endDrag);

    // Browsers start a native image drag otherwise, which kills the gesture.
    reel.addEventListener("dragstart", (event) => {
      if (dragging) event.preventDefault();
    });

    /*
     * Swallow the click that follows a real drag, so that anything clickable
     * added inside the reel later doesn't fire when the visitor was only
     * scrolling. Capture phase, to get in before any such handler.
     */
    reel.addEventListener(
      "click",
      (event) => {
        if (!dragMoved) return;
        event.preventDefault();
        event.stopPropagation();
        dragMoved = false;
      },
      true,
    );

    // "03 / 14" readout, if this reel asked for one.
    const shell = reel.closest(".reel-shell");
    const indexEl = shell?.querySelector<HTMLElement>("[data-reel-index]");
    const totalEl = shell?.querySelector<HTMLElement>("[data-reel-total]");

    if (indexEl && totalEl) {
      const pad = (n: number) => String(n).padStart(2, "0");
      let queued = false;

      const updateCounter = () => {
        queued = false;
        const { index, total } = nearestPoint();
        indexEl.textContent = pad(index + 1);
        totalEl.textContent = pad(total);
      };

      reel.addEventListener(
        "scroll",
        () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(updateCounter);
        },
        { passive: true },
      );

      updateCounter();
      layoutListeners.push(updateCounter);
    }
  }
</script>
