---
/*
 * A framed picture that sits under a flat colour tint at rest (the site's
 * straw gold by default) and returns to its true colours on hover/focus. The
 * caption fades in over the revealed image on a translucent scrim, so the
 * photo stays readable underneath the text rather than being covered by it.
 *
 * Built as a media primitive rather than a card: pass the caption as the
 * default slot and let the calling card own the heading level, tags and
 * links.
 */
import { Image } from 'astro:assets'

interface Props {
  /** Local import (ImageMetadata) or a remote URL string from the API. */
  src: ImageMetadata | string
  alt: string
  /** Tint painted over the desaturated image. Any CSS colour. */
  tint?: string
  /** Frame aspect ratio, e.g. "16 / 9". */
  ratio?: string
  /** Makes the whole frame a link target. */
  href?: string
  /** Accessible name for `href` when the caption isn't descriptive enough. */
  linkLabel?: string
  /** Show true colours and the caption without waiting for a hover. */
  revealed?: boolean
  /* Remote images can't be measured at build time, so Astro needs the
     intrinsic size up front; these are only used on the string branch. */
  width?: number
  height?: number
  class?: string
  style?: string
  [key: string]: unknown
}

const {
  src,
  alt,
  tint,
  ratio,
  href,
  linkLabel,
  revealed = false,
  width = 800,
  height = 600,
  class: className,
  style: styleProp,
  ...rest
} = Astro.props

const isRemote = typeof src === 'string'
const hasCaption = Astro.slots.has('default')

/*
 * Merged rather than spread through `rest`, so a caller passing its own
 * `style` (to override one of the `--fi-*` knobs) doesn't silently drop the
 * declarations `tint`/`ratio` produced. Caller's wins, being last.
 */
const style = [tint && `--fi-tint: ${tint}`, ratio && `--fi-ratio: ${ratio}`, styleProp]
  .filter(Boolean)
  .join('; ')
---

<figure
  class:list={['fi', className, { 'fi--revealed': revealed }]}
  style={style || undefined}
  {...rest}
>
  {
    isRemote ? (
      <img
        class="fi__img"
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <Image class="fi__img" src={src} alt={alt} />
    )
  }

  {/* Purely decorative — the image below it already carries the meaning. */}
  <span class="fi__tint" aria-hidden="true"></span>

  {
    href && (
      <a class="fi__link" href={href}>
        <span class="fi__link-label">{linkLabel ?? alt}</span>
      </a>
    )
  }

  {
    /* Last child so it stays a valid `figcaption`, then absolutely
       positioned back over the frame. */
    hasCaption && (
      <figcaption class="fi__caption">
        <slot />
      </figcaption>
    )
  }
</figure>

<style>
  /*
   * One registered number drives every reveal: tint opacity, grayscale amount,
   * caption fade and zoom all read from it, so hover, focus and the
   * `revealed` prop only ever have to flip this single value. Registering it
   * is what makes it interpolate — an unregistered custom property would jump.
   */
  @property --fi-reveal {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  .fi {
    --fi-tint: var(--primary, #e3c567);
    --fi-ratio: 4 / 3;
    --fi-tint-opacity: 0.88;
    --fi-blend: multiply;
    --fi-duration: 450ms;
    --fi-scrim: color-mix(in srgb, var(--background, #131200) 88%, transparent);
    --fi-caption-color: var(--secondary, #fef7cb);

    /* Also the pre-@property fallback: without registration the reveal simply
       snaps between states instead of easing. */
    --fi-reveal: 0;

    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: var(--fi-ratio);
    background: var(--fi-tint);
    /* Contains the tint's blending, which would otherwise multiply straight
       through to the page background. */
    isolation: isolate;
    transition: --fi-reveal var(--fi-duration) ease;
  }

  /* Touch devices get no hover, so a tint that never lifts would just be a
     broken-looking photo — show them the revealed state outright. */
  @media (hover: none) {
    .fi {
      --fi-reveal: 1;
    }
  }

  @media (hover: hover) {
    .fi:hover,
    .fi:focus-within {
      --fi-reveal: 1;
    }
  }

  .fi--revealed {
    --fi-reveal: 1;
  }

  .fi__img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: grayscale(calc(1 - var(--fi-reveal, 0)))
      contrast(calc(1 + 0.15 * (1 - var(--fi-reveal, 0))));
    /* Slight settle out of the zoom on reveal; the resting overscale also
       keeps the scaled edges outside the frame. */
    scale: calc(1.06 - 0.04 * var(--fi-reveal, 0));
    transition: scale var(--fi-duration) ease;
  }

  .fi__tint {
    position: absolute;
    inset: 0;
    background: var(--fi-tint);
    mix-blend-mode: var(--fi-blend);
    opacity: calc(var(--fi-tint-opacity) * (1 - var(--fi-reveal, 0)));
    pointer-events: none;
  }

  .fi__caption {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    /* Deep top padding on purpose: it gives the gradient below somewhere to
       fade out that isn't on top of the text. */
    padding: calc(var(--space-md, 1rem) * 2.5) var(--space-md, 1rem) var(--space-md, 1rem);
    color: var(--fi-caption-color);
    /* Translucent, not opaque: the point of the reveal is that the real
       colours stay visible behind the text. Full strength across the text
       itself — a gradient that starts thinning straight away leaves the
       first line unreadable over a light photo, which most UI screenshots
       are. */
    background: linear-gradient(
      to top,
      var(--fi-scrim),
      var(--fi-scrim) 60%,
      color-mix(in srgb, var(--fi-scrim) 40%, transparent) 82%,
      transparent
    );
    opacity: var(--fi-reveal, 0);
    translate: 0 calc(1rem * (1 - var(--fi-reveal, 0)));
  }

  .fi__caption :global(*) {
    margin-block: 0;
  }

  .fi__caption :global(* + *) {
    margin-block-start: 0.35em;
  }

  /* Stretched link: the anchor itself is a zero-size focus target, its
     ::after covers the frame so the whole picture is clickable. */
  .fi__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .fi__link:focus-visible::after {
    outline: 2px solid var(--fi-caption-color);
    outline-offset: -4px;
  }

  .fi__link-label {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .fi,
    .fi__img {
      transition: none;
    }

    .fi__img {
      scale: 1;
    }
  }
</style>
